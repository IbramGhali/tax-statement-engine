# Copy to .env to change settings. Every value is optional; the defaults run offline on SQLite
# with the mock accounting provider started in-process.

# Database. Empty means SQLite at .tse/tse.db. For the docker compose Postgres:
# TSE_DATABASE_URL=postgresql+psycopg://tse:tse@localhost:5433/tse
TSE_DATABASE_URL=

# Accounting provider. Empty starts the bundled mock provider in-process.
# With docker compose running: TSE_ACCOUNTING_URL=http://localhost:9000
TSE_ACCOUNTING_URL=

# Commentary model: fake (default, offline, deterministic) | anthropic
TSE_LLM_PROVIDER=fake
TSE_COMMENTARY_MODEL=claude-opus-5-5

# Worker pool and provider client
TSE_WORKERS=4
TSE_CLIENT_RATE=20
TSE_CLIENT_CONCURRENCY=8
TSE_REQUEST_TIMEOUT=2.0
TSE_MAX_JOB_ATTEMPTS=4

# Fake commentary only: share of notes that round a figure, to exercise the grounding check.
TSE_FAKE_COMMENTARY_DRIFT=0.05

# Paths
# TSE_DATA_DIR=data
# TSE_OUTPUT_DIR=outputs
# TSE_STATE_DIR=.tse

# Only for the live commentary adapter. Never commit a real key.
# ANTHROPIC_API_KEY=
# TSE_LIVE_TESTS=0
